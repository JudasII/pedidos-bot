# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Secrets and local environment
.env
.env.*
!.env.example

# Real data: NEVER committed (real chats, exports, anonymized cases)
data/private/
!data/private/.gitkeep

# Local databases and artifacts
*.db
*.db-wal
*.db-shm
*.sqlite
var/

# Evaluation reports (only selected summaries in eval/reports/published/ are tracked)
eval/reports/*
!eval/reports/.gitkeep
!eval/reports/published/

# IDEs / OS
.idea/
.vscode/
.DS_Store
