# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Secretos y entorno local
.env
.env.*
!.env.example

# Datos reales: NUNCA se suben (chats reales, exports, casos anonimizados)
data/private/
