# Bases de datos locales y artefactos
*.db
*.db-wal
*.db-shm
*.sqlite
var/

# Reportes de evaluación (se versionan solo los resúmenes elegidos en eval/reports/published/)
eval/reports/*
!eval/reports/.gitkeep
!eval/reports/published/

# IDEs / SO
.idea/
.vscode/
.DS_Store
