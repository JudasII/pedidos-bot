# Copy to .env and fill in the values. .env is git-ignored.

# --- Telegram (development channel) ---
TELEGRAM_BOT_TOKEN=
# Restaurant (group) chat that receives orders and handoffs, per restaurant:
BURGER_DEMO_STAFF_CHAT_ID=
MINIMAL_DEMO_STAFF_CHAT_ID=

# --- LLM ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
# Only for comparative evaluation against hosted models:
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_API_KEY=

# --- Persistence (PostgreSQL via docker compose) ---
DATABASE_URL=postgresql://pedidos:pedidos@localhost:5432/pedidos

# --- Observability ---
LOG_LEVEL=INFO
# Salt used to hash customer identifiers in logs/traces (generate a random one):
PII_HASH_SALT=
# Self-hosted Langfuse (OTLP endpoint + project keys)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
