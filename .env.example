# Copia este archivo a .env y completa los valores. .env está en .gitignore.

# --- Telegram (canal de desarrollo) ---
TELEGRAM_BOT_TOKEN=
# Chat (grupo) del restaurante donde llegan pedidos y escalamientos, por restaurante:
BURGER_DEMO_STAFF_CHAT_ID=
MINIMAL_DEMO_STAFF_CHAT_ID=

# --- LLM ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
# Solo para evaluación comparativa con modelos hospedados:
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_API_KEY=

# --- Persistencia ---
DATABASE_PATH=var/pedidos.db

# --- Observabilidad ---
LOG_LEVEL=INFO
# Sal para hashear identificadores de clientes en logs/trazas (genera uno aleatorio):
PII_HASH_SALT=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
